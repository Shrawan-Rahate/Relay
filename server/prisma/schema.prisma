generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  REVIEWER
  OUTGOING
  INCOMING
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  name         String?
  passwordHash String
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  memberships  ProjectMember[]
  sessions     AuthSession[]
  extractionRuns ExtractionRun[]
  clarificationResponses ClarificationResponse[]
  reviewDecisions ReviewDecision[]
  importedSources Source[]
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  members     ProjectMember[]
  sources     Source[]
  extractionRuns ExtractionRun[]
  knowledgeGaps KnowledgeGap[]
  clarificationResponses ClarificationResponse[]
  reviewDecisions ReviewDecision[]
  sourceDocuments SourceDocument[]
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum SourceType {
  MARKDOWN
  CSV
  GITHUB
}

model Source {
  id              String           @id @default(uuid()) @db.Uuid
  projectId       String           @db.Uuid
  importedById    String           @db.Uuid
  type            SourceType
  filename        String
  originalContent String
  sha256          String           @db.Char(64)
  byteSize        Int
  metadata        Json             @default("{}")
  provenance      Json
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  importedBy      User             @relation(fields: [importedById], references: [id], onDelete: Restrict)
  documents       SourceDocument[]

  @@unique([projectId, sha256])
  @@unique([id, projectId])
  @@index([importedById])
}

model SourceDocument {
  id        String   @id @default(uuid()) @db.Uuid
  sourceId  String   @db.Uuid
  projectId String   @db.Uuid
  position  Int
  content   String
  sha256    String   @db.Char(64)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  source    Source   @relation(fields: [sourceId, projectId], references: [id, projectId], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  evidence ClaimEvidence[]
  clarificationEvidence ClarificationResponseEvidence[]

  @@unique([id, projectId])
  @@unique([sourceId, position])
  @@index([projectId])
}


enum ExtractionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ClaimType {
  DECISION
  OWNER
  DEPENDENCY
  STATUS
  RISK
}

enum ClaimStatus {
  UNVERIFIED
}

model ExtractionRun {
  id            String @id @default(uuid()) @db.Uuid
  projectId     String @db.Uuid
  requestedById String @db.Uuid
  provider      String @default("gemini")
  model         String
  modelVersion  String?
  provenance    Json
  status        ExtractionStatus @default(RUNNING)
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime @default(now()) @db.Timestamptz(3)
  completedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy   User @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  claims        KnowledgeClaim[]

  @@unique([id, projectId])
  @@index([projectId, createdAt])
  @@index([requestedById])
}

model KnowledgeClaim {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  runId     String @db.Uuid
  type      ClaimType
  text      String
  status    ClaimStatus @default(UNVERIFIED)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  run       ExtractionRun @relation(fields: [runId, projectId], references: [id, projectId], onDelete: Cascade)
  evidence  ClaimEvidence[]
  gapLinks KnowledgeGapClaim[]

  @@unique([id, projectId])
  @@index([projectId, createdAt])
  @@index([runId, projectId])
}

model ClaimEvidence {
  id         String @id @default(uuid()) @db.Uuid
  projectId  String @db.Uuid
  claimId    String @db.Uuid
  documentId String @db.Uuid
  quote      String
  startOffset Int
  endOffset   Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  claim      KnowledgeClaim @relation(fields: [claimId, projectId], references: [id, projectId], onDelete: Cascade)
  document   SourceDocument @relation(fields: [documentId, projectId], references: [id, projectId], onDelete: Restrict)

  @@index([claimId, projectId])
  @@index([documentId, projectId])
}


enum KnowledgeGapCategory {
  MISSING_OWNER
  UNCLEAR_STATUS
  UNRESOLVED_DEPENDENCY
  POTENTIAL_CONFLICT
}

enum KnowledgeGapStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model KnowledgeGap {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  category    KnowledgeGapCategory
  status      KnowledgeGapStatus @default(OPEN)
  question    String
  fingerprint String @db.Char(64)
  provenance  Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  claimLinks  KnowledgeGapClaim[]
  clarificationResponses ClarificationResponse[]

  @@unique([id, projectId])
  @@unique([projectId, fingerprint])
  @@index([projectId, status, id])
}

model KnowledgeGapClaim {
  gapId      String @db.Uuid
  claimId    String @db.Uuid
  projectId  String @db.Uuid
  provenance Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  gap        KnowledgeGap @relation(fields: [gapId, projectId], references: [id, projectId], onDelete: Cascade)
  claim      KnowledgeClaim @relation(fields: [claimId, projectId], references: [id, projectId], onDelete: Restrict)

  @@id([gapId, claimId])
  @@index([claimId, projectId])
  @@index([gapId, projectId])
}


enum ClarificationResponseStatus {
  PENDING_REVIEW
}

model ClarificationResponse {
  id         String @id @default(uuid()) @db.Uuid
  projectId  String @db.Uuid
  gapId      String @db.Uuid
  authorId   String @db.Uuid
  answerText String
  status     ClarificationResponseStatus @default(PENDING_REVIEW)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gap        KnowledgeGap @relation(fields: [gapId, projectId], references: [id, projectId], onDelete: Cascade)
  author     User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  evidence   ClarificationResponseEvidence[]
  reviews    ReviewDecision[]

  @@unique([id, projectId])
  @@index([projectId, gapId, createdAt, id])
  @@index([gapId, projectId])
  @@index([authorId])
}

model ClarificationResponseEvidence {
  id             String @id @default(uuid()) @db.Uuid
  responseId     String @db.Uuid
  projectId      String @db.Uuid
  documentId     String @db.Uuid
  quote          String
  startOffset    Int
  endOffset      Int
  documentSha256 String @db.Char(64)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  response       ClarificationResponse @relation(fields: [responseId, projectId], references: [id, projectId], onDelete: Cascade)
  document       SourceDocument @relation(fields: [documentId, projectId], references: [id, projectId], onDelete: Restrict)

  @@index([responseId, projectId])
  @@index([documentId, projectId])
}


enum ReviewAction {
  APPROVE
  EDIT
  REJECT
  DEFER
}

model ReviewDecision {
  id            String @id @default(uuid()) @db.Uuid
  projectId     String @db.Uuid
  responseId    String @db.Uuid
  reviewerId    String @db.Uuid
  sequence      Int
  action        ReviewAction
  correctedText String?
  reason        String?
  resolveGap    Boolean @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  response      ClarificationResponse @relation(fields: [responseId, projectId], references: [id, projectId], onDelete: Cascade)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer      User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([responseId, sequence])
  @@index([responseId, projectId])
  @@index([projectId, createdAt])
  @@index([reviewerId])
}
